{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with approval status and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "approved", "blocked"] },
        "role": { "type": "string", "enum": ["buyer", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "status", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrative authority registry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "assignedAt": { "type": "string" }
      },
      "required": ["uid", "email", "assignedAt"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Batch of plaques generated by a buyer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "modelId": { "type": "string", "maxLength": 20 },
        "quantity": { "type": "number" },
        "startNumber": { "type": "number" },
        "endNumber": { "type": "number" },
        "createdAt": { "type": "string" },
        "plaqueCount": { "type": "number" }
      },
      "required": ["id", "uid", "name", "modelId", "quantity", "startNumber", "endNumber", "createdAt"]
    },
    "Plaque": {
      "title": "Plaque",
      "description": "Single plaque containing sequential number and dynamic QR redirect reference",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "batchId": { "type": "string", "maxLength": 128 },
        "sequentialNumber": { "type": "number" },
        "numberFormatted": { "type": "string", "maxLength": 20 },
        "publicId": { "type": "string", "maxLength": 64 },
        "targetUrl": { "type": "string", "maxLength": 1000 },
        "modelId": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "clicks": { "type": "number" }
      },
      "required": ["id", "uid", "batchId", "sequentialNumber", "numberFormatted", "publicId", "targetUrl", "modelId", "createdAt", "updatedAt"]
    },
    "Redirect": {
      "title": "Redirect",
      "description": "Public lookup record for dynamic QR code routing",
      "type": "object",
      "properties": {
        "publicId": { "type": "string", "maxLength": 64 },
        "plaqueId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "targetUrl": { "type": "string", "maxLength": 1000 },
        "batchId": { "type": "string", "maxLength": 128 },
        "clicks": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["publicId", "plaqueId", "ownerUid", "targetUrl", "active", "updatedAt"]
    },
    "AdminAudit": {
      "title": "AdminAudit",
      "description": "Audit record of actions performed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "targetUid": { "type": "string", "maxLength": 128 },
        "targetEmail": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string" },
        "details": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "adminUid", "adminEmail", "targetUid", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with authorization state"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Admin registry verifying platform administrators"
    },
    "/users/{userId}/batches/{batchId}": {
      "schema": "Batch",
      "description": "Batches belonging to the specified user"
    },
    "/users/{userId}/plaques/{plaqueId}": {
      "schema": "Plaque",
      "description": "Plaques belonging to the specified user"
    },
    "/redirects/{publicId}": {
      "schema": "Redirect",
      "description": "Public destination lookup records for dynamic QR codes"
    },
    "/adminAudit/{auditId}": {
      "schema": "AdminAudit",
      "description": "Logs of administrative approval and blocking actions"
    }
  }
}
