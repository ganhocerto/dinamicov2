# Variáveis do Firebase Client (Vite)
# Configure estas variáveis no seu painel da Vercel ou no arquivo .env local
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="dinamico-pro-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="dinamico-pro-project"
VITE_FIREBASE_STORAGE_BUCKET="dinamico-pro-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# URL base da aplicação para redirecionamento público dos QR Codes
# Em produção na Vercel: https://seu-dominio.vercel.app
VITE_APP_URL="http://localhost:3000"

# Administrador inicial padrão (validado e verificado com segurança)
VITE_INITIAL_ADMIN_EMAIL="jeannmkt2@gmail.com"
